{
  "name": "nova-creator-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "pnpm --filter @nova/web dev",
    "dev:admin": "pnpm --filter @nova/admin dev",
    "dev:desktop": "pnpm --filter @nova/desktop dev",
    "package:desktop": "pnpm --filter @nova/desktop package",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
